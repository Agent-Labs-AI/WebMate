+// AgentX: a provider's Retry-After header would be lost with the response;
+// written into the error text, the side panel can say how long to wait.
+function retryAfterNote(res) {
+  const value = String(res?.headers?.get?.('retry-after') || '').trim();
+  const seconds = /^\d+$/.test(value)
+    ? Number(value)
+    : Math.ceil((Date.parse(value) - Date.now()) / 1000);
+  return Number.isFinite(seconds) && seconds > 0 ? ` (Retry-After: ${seconds})` : '';
+}
